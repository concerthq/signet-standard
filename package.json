{
  "name": "signet-standard",
  "version": "0.10.0",
  "description": "SIGNET Canonical Data Model \u2014 the normative open standard for governed procurement networks. Stewarded by Concert Foundation.",
  "license": "CC0-1.0",
  "homepage": "https://concert.foundation/standard",
  "repository": {
    "type": "git",
    "url": "https://github.com/concerthq/signet-standard"
  },
  "scripts": {
    "validate": "node validate.js",
    "transform": "node tools/signet-to-ubl.js > examples/invoice.ubl.xml",
    "verify-ubl": "python3 tools/verify-ubl.py",
    "conformance": "node conformance/runner/run-conformance.js",
    "conformance:broken": "node conformance/runner/run-conformance.js --adapter conformance/adapter/broken-adapter.js",
    "conformance:commodity-risk": "node conformance/rules/check-commodity-risk.js",
    "test:projection-skip": "node tools/test-projection-skip.js",
    "agent": "node agent/run-agent.js",
    "onboarding": "node onboarding/run-onboarding.js",
    "auction": "node auction/run-auction.js"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1"
  }
}
