{
  "name": "signet-standard",
  "version": "0.16.1",
  "description": "SIGNET Canonical Data Model — the normative open standard for governed procurement networks. Stewarded by Concert Foundation.",
  "license": "CC0-1.0",
  "homepage": "https://concert.foundation/standard",
  "repository": {
    "type": "git",
    "url": "https://github.com/concerthq/signet-standard"
  },
  "scripts": {
    "validate": "node validate.js",
    "transform": "node tools/signet-to-ubl.js > examples/invoice.ubl.xml",
    "verify-ubl": "python3 tools/verify-ubl.py",
    "conformance": "node conformance/runner/run-conformance.js",
    "conformance:broken": "node conformance/runner/run-conformance.js --adapter conformance/adapter/broken-adapter.js",
    "conformance:endorsements": "node conformance/rules/check-endorsements.js",
    "conformance:endorsements:broken": "node conformance/rules/check-endorsements.js --adapter conformance/adapter/broken-adapter.js",
    "conformance:codelists": "node conformance/rules/check-codelists.js",
    "lint:marks": "node tools/lint-mark-strings.js",
    "conformance:state-model": "node conformance/rules/check-state-model.js .",
    "conformance:public-interface": "node conformance/rules/check-public-interface.js .",
    "conformance:commodity-risk": "node conformance/rules/check-commodity-risk.js",
    "conformance:extensions": "node conformance/rules/check-onboarding.js && node conformance/rules/check-auction.js && node conformance/rules/check-identity.js",
    "test:projection-skip": "node tools/test-projection-skip.js",
    "agent": "node agent/run-agent.js",
    "onboarding": "node onboarding/run-onboarding.js",
    "auction": "node auction/run-auction.js",
    "conformance:dialect": "node conformance/rules/check-dialect-equivalence.js",
    "inventory": "node tools/inventory/inventory.js",
    "inventory:verify": "node tools/inventory/inventory.js --verify",
    "inventory:self-test": "node tools/inventory/inventory.js --self-test"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1"
  }
}
