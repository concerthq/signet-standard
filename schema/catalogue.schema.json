{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://concert.foundation/signet/v0.1/catalogue.schema.json",
  "title": "Catalogue",
  "description": "A structured offering of goods/services (UBL Catalogue / Peppol BIS Catalogue aligned).",
  "type": "object",
  "required": [
    "id",
    "providerParty",
    "items"
  ],
  "patternProperties": {
    "^[a-z][a-z0-9-]*:[A-Za-z][A-Za-z0-9]*$": {}
  },
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": [
        "string",
        "object",
        "array"
      ]
    },
    "type": {
      "const": "Catalogue"
    },
    "id": {
      "$ref": "definitions.schema.json#/definitions/Identifier"
    },
    "providerParty": {
      "$ref": "definitions.schema.json#/definitions/Identifier"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions.schema.json#/definitions/Item"
      }
    },
    "validityPeriod": {
      "$ref": "definitions.schema.json#/definitions/Period"
    }
  }
}
