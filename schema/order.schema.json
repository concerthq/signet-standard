{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://concert.foundation/signet/v0.1/order.schema.json",
  "title": "Order",
  "description": "A call-off or purchase order against a contract or catalogue (UBL Order aligned).",
  "type": "object",
  "required": [
    "id",
    "buyer",
    "seller",
    "items",
    "value"
  ],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": [
        "string",
        "object",
        "array"
      ]
    },
    "type": {
      "const": "Order"
    },
    "id": {
      "$ref": "definitions.schema.json#/definitions/Identifier"
    },
    "contract": {
      "$ref": "definitions.schema.json#/definitions/Identifier",
      "description": "The contract drawn against."
    },
    "buyer": {
      "$ref": "definitions.schema.json#/definitions/Identifier"
    },
    "seller": {
      "$ref": "definitions.schema.json#/definitions/Identifier"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions.schema.json#/definitions/Item"
      }
    },
    "value": {
      "$ref": "definitions.schema.json#/definitions/Value"
    },
    "deliveryPeriod": {
      "$ref": "definitions.schema.json#/definitions/Period"
    }
  }
}
