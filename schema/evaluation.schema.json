{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://concert.foundation/signet/v0.1/evaluation.schema.json",
  "title": "Evaluation",
  "description": "The scoring of a submission against the evaluation criteria.",
  "type": "object",
  "required": [
    "id",
    "submission",
    "criteria",
    "scores",
    "evaluatedBy",
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": [
        "string",
        "object",
        "array"
      ]
    },
    "type": {
      "const": "Evaluation"
    },
    "id": {
      "$ref": "definitions.schema.json#/definitions/Identifier"
    },
    "submission": {
      "$ref": "definitions.schema.json#/definitions/Identifier"
    },
    "criteria": {
      "$ref": "definitions.schema.json#/definitions/Identifier",
      "description": "Reference to the Policy holding the evaluation model."
    },
    "scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions.schema.json#/definitions/Score"
      }
    },
    "evaluatedBy": {
      "$ref": "definitions.schema.json#/definitions/Identifier",
      "description": "The agent (human or synthetic) performing the evaluation."
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "ranked"
      ]
    },
    "decision": {
      "$ref": "definitions.schema.json#/definitions/Identifier",
      "description": "Link to the Decision record."
    }
  }
}
